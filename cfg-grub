. "`dirname "${0}"`/brltty-prologue.sh"

handleInitialHelpOption "${@}" <<END-OF-HELP
Configure a BRLTTY build for the GRUB boot loader.

Syntax: ${programName} {-h | [-option ...]}

All of the options are passed through, unmodified, as additional
options to the configure script.

The GRUB target platform is auto-detected from the installed GRUB.
Override with: ${programName} --with-grub-platform=i386-pc
               ${programName} --with-grub-platform=x86_64-efi

Prerequisites (Fedora/RHEL):
   dnf install gcc make

Prerequisites (Debian/Ubuntu):
   apt install gcc make

A GRUB source tree must be symlinked as grub-root in the BRLTTY
source directory (see Documents/README.Grub for details).
END-OF-HELP

# Braille drivers already disabled:
# ba (by --disable-api)
# il (not on Linux)
# lb (by --without-libbraille)
# xw (by --disable-x)

# Determine the GRUB target platform.
# GRUB modules must match the installed GRUB's architecture:
#   i386-pc       — Legacy BIOS (32-bit modules)
#   x86_64-efi    — 64-bit UEFI (64-bit modules)
#   i386-efi      — 32-bit UEFI (32-bit modules)
grubPlatform=""
configureArgs=()
for option
do
   case "${option}"
   in
      --with-grub-platform=*)
         grubPlatform="${option#*=}"
         ;;
      *)
         configureArgs+=("${option}")
         ;;
   esac
done

if [ -z "${grubPlatform}" ]
then
   # Auto-detect from installed GRUB modules.
   for dir in /boot/grub/x86_64-efi /boot/grub2/x86_64-efi \
              /boot/grub/i386-pc /boot/grub2/i386-pc \
              /boot/grub/i386-efi /boot/grub2/i386-efi
   do
      if [ -d "${dir}" ]
      then
         grubPlatform="${dir##*/}"
         break
      fi
   done
fi

if [ -z "${grubPlatform}" ]
then
   echo "${programName}: cannot detect GRUB platform." >&2
   echo "Use --with-grub-platform=x86_64-efi or --with-grub-platform=i386-pc" >&2
   exit 1
fi

echo "${programName}: building for GRUB platform: ${grubPlatform}"

# Set compiler flags and CPU directory based on GRUB platform.
# GRUB uses the native system GCC with -m32 or -m64 as needed.
# No cross-compiler is required for native-architecture builds.
#
# The CPU determines pointer sizes and ABI — modules must match.
# GRUB's own convention: i386-pc and i386-efi are 32-bit,
# x86_64-efi is 64-bit.
grubCC="${CC:-gcc}"
grubCFLAGS=""
grubCpuDir=""

case "${grubPlatform}"
in
   i386-*)
      grubCFLAGS="-m32"
      grubCpuDir="i386"
      ;;
   x86_64-*)
      grubCFLAGS="-m64"
      grubCpuDir="x86_64"
      ;;
   *)
      echo "${programName}: unsupported GRUB platform: ${grubPlatform}" >&2
      exit 1
      ;;
esac

# GRUB modules are relocatable ELF objects loaded by GRUB's own linker,
# which only handles a limited set of relocation types. The flags below
# match what GRUB uses to compile its own modules:
#   -mcmodel=large    Use absolute addressing, avoiding GOT-relative
#                     relocations (R_X86_64_REX_GOTPCRELX) that GRUB's
#                     x86_64 relocator does not implement.
#   -fno-PIC          Disable position-independent code (same reason).
#   -mno-red-zone     Required for code that may run at interrupt context.
#   -msoft-float      No x87/SSE — GRUB does not save FPU state.
#   -mno-mmx/sse/sse2/3dnow  No SIMD instructions.
#   -fno-stack-protector     No __stack_chk_fail in freestanding.
grubCFLAGS="${grubCFLAGS} -fno-PIC -fno-PIE -mcmodel=large"
grubCFLAGS="${grubCFLAGS} -mno-red-zone -msoft-float"
grubCFLAGS="${grubCFLAGS} -mno-mmx -mno-sse -mno-sse2 -mno-3dnow"
grubCFLAGS="${grubCFLAGS} -fno-stack-protector"

# GRUB headers use #include <grub/cpu/types.h> where "cpu" is a symlink
# to the target architecture directory (e.g. grub/i386 or grub/x86_64).
# This symlink is normally created by GRUB's own configure, but since we
# only need the headers (not a full GRUB build), we create it ourselves.
grubRoot="${programDirectory}/grub-root"
if [ ! -d "${grubRoot}" ]
then
   echo "${programName}: grub-root symlink not found." >&2
   echo "Create it with: ln -s /path/to/grub ${grubRoot}" >&2
   exit 1
fi

if [ ! -e "${grubRoot}/include/grub/cpu" ]
then
   echo "${programName}: creating grub/cpu -> grub/${grubCpuDir} symlink"
   ln -sf "${grubCpuDir}" "${grubRoot}/include/grub/cpu"
fi

# For platform-specific headers (grub/machine), create that symlink too
# if there's a matching platform subdirectory.
grubMachineDir="${grubRoot}/include/grub/${grubCpuDir}/${grubPlatform#*-}"
if [ -d "${grubMachineDir}" ] && [ ! -e "${grubRoot}/include/grub/machine" ]
then
   echo "${programName}: creating grub/machine -> grub/${grubCpuDir}/${grubPlatform#*-} symlink"
   ln -sf "${grubCpuDir}/${grubPlatform#*-}" "${grubRoot}/include/grub/machine"
fi

configureOptions=(
   --enable-standalone-programs

   --disable-api
   --disable-expat
   --disable-icu
   --disable-gpm
   --disable-polkit
   --disable-x

   --without-libbraille
   --without-pgmpath-package
   --without-service-package
   --without-params-package
   --without-rgx-package
   --without-hostcmd-package
   --without-mntpt-package
   --without-mntfs-package

   # All braille drivers must be built-in (internal) because GRUB has no
   # shared library loader. List desired drivers without a '-' prefix,
   # and end with '-all' to exclude the rest. Included here are drivers
   # that support USB and/or serial — the only transports available in GRUB.
   --with-braille-driver=al,at,bm,bn,cb,ce,cn,dp,eu,fa,fs,hd,hm,ht,hw,ic,ir,md,mm,mn,mt,np,pg,pm,sk,ts,vo,-all

   --disable-speech-support

   --with-screen-driver=gb,-all

   --without-bell-package
   --without-leds-package

   --without-pcm-package
   --without-midi-package
   --without-fm-package

   # Use --host=i386-elf to trigger GRUB_RUNTIME platform detection in
   # configure.ac, but override all tools so the native system toolchain
   # is used instead of looking for i386-elf-* cross tools.
   --host=i386-elf
   CC="${grubCC}"
   CPP="${grubCC} -E"
   CFLAGS="${grubCFLAGS} -Wno-incompatible-pointer-types"
   LD=ld
   STRIP=strip
   RANLIB=ranlib
)

"${programDirectory}/configure" --quiet "${configureOptions[@]}" "${configureArgs[@]}"
exit "${?}"
